#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
    [ -x /usr/bin/python3 ] || return 1
    [ -f /root/airmx-recovery/recovery_server.py ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/airmx-recovery/recovery_server.py serve \
        --data-dir /root/airmx-recovery/data \
        --bind 192.0.2.1 \
        --http-port 25880 \
        --mqtt-port 25884 \
        --admin-port 25886 \
        --api-port 25887 \
        --api-token-file /root/airmx-recovery/data/api-token \
        --api-client-ip 192.0.2.30 \
        --relay-sensor
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
